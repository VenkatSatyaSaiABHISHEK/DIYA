# DIYA AI - Environment Variables Example
# Duplicate this file to .env.local in frontend/ or set in your deployment environment

# API Base URL (Backend service)
NEXT_PUBLIC_API_URL=https://api.diya.mentneo.ai/v1

# Mock Adapter Switch
# When set to 'true', services return realistic mock data with a visible "Demo data" badge
# When set to 'false', services call the actual backend API
NEXT_PUBLIC_USE_MOCKS=true

# Auth Secret for session handling and proxy security
AUTH_SECRET=super_secret_session_key_diya_32_chars_min_example

# Node Environment
NODE_ENV=development
